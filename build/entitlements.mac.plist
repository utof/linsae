<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Referenced by electron-builder.yml's `mac.entitlementsInherit`, which pointed
  at this path since the project was scaffolded while the file did not exist.
  Created rather than dropping the key: the `mac.extendInfo` block already
  declares camera / microphone / Documents / Downloads usage descriptions, and
  deleting the reference would silently lose the matching entitlements the first
  time anyone builds for macOS.

  These are the inherited entitlements for child (renderer/GPU) processes. The
  JIT / unsigned-executable-memory pair is required by V8; the others mirror the
  NSCameraUsageDescription / NSMicrophoneUsageDescription declarations.

  Not yet exercised — no macOS build has been produced. See docs/specs/v0.8.1-housekeeping.md §3.2.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.app-sandbox</key>
    <false/>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.debugger</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
  </dict>
</plist>
