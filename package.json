{
  "name": "linsae",
  "version": "0.8.1",
  "description": "Local-first note-taking: a chronological markdown feed with wikilinks, a spatial canvas, a PDF reader with excerpt capture, and timestamped YouTube annotation.",
  "main": "./out/main/index.js",
  "author": "utof",
  "homepage": "https://github.com/utof/linsae",
  "license": "MIT",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "node scripts/ensure-electron-abi.mjs && electron-vite dev",
    "build": "electron-vite build && electron-builder",
    "preview": "electron-vite preview",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "pnpm rebuild better-sqlite3",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "biome check --write .",
    "lint:check": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "electron-vite build && node scripts/ensure-electron-abi.mjs && xvfb-run -a -s '-screen 0 1440x900x24' playwright test",
    "test:visual:update": "electron-vite build && node scripts/ensure-electron-abi.mjs && xvfb-run -a -s '-screen 0 1440x900x24' playwright test --update-snapshots",
    "knip": "knip",
    "smoke:capture": "node scripts/capture-smoke.mjs",
    "smoke:thread": "node scripts/thread-smoke.mjs",
    "smoke:feed": "node scripts/feed-scroll-smoke.mjs",
    "smoke:feed-restore": "node scripts/feed-scroll-restore-smoke.mjs",
    "smoke:pdf": "node scripts/pdf-render-smoke.mjs",
    "smoke:pdf-multipage": "node scripts/pdf-multipage-smoke.mjs",
    "spike:canvas": "node scripts/spike-canvas/run.mjs",
    "harness:send": "xvfb-run -a node scripts/send-harness.mjs",
    "harness:reveal": "xvfb-run -a node scripts/reveal-stress.mjs",
    "harness:canvas": "node scripts/canvas-perf-harness.mjs",
    "harness:canvas:smoke": "node scripts/canvas-perf-harness.mjs --smoke",
    "doctor": "npx react-doctor@latest",
    "smoke:packaged": "xvfb-run -a node scripts/packaged-app-smoke.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "js-yaml": "^4.1.1",
    "pdfjs-dist": "^6.0.227",
    "uuidv7": "^1.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/rebuild": "^4.0.4",
    "@playwright/test": "^1.62.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-virtual": "^3.14.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.19.1",
    "@types/rbush": "^4.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "cmdk": "^1.1.1",
    "electron": "^42.5.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "6.0.0-beta.1",
    "happy-dom": "^20.9.0",
    "katex": "^0.17.0",
    "knip": "^6.14.2",
    "lefthook": "^2.1.8",
    "lucide-react": "^1.16.0",
    "motion": "^12.40.0",
    "perfect-freehand": "^1.2.3",
    "playwright": "^1.62.1",
    "rbush": "^4.0.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hotkeys-hook": "^5.3.2",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "zustand": "^5.0.14"
  }
}
