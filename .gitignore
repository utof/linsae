node_modules
dist
out
.DS_Store
.eslintcache
*.log*

# linsae additions
out/
dist/
.electron-builder-cache/
*.log
.vite/
*.tsbuildinfo
.claude/
# DevTools performance traces dropped into docs/ for analysis — NOT source.
# Narrow on purpose: a bare `docs/` would shadow the `!/docs/**/*.md` rule
# below (git can't re-include files under an excluded dir), un-tracking the
# in-repo specs/plans/ADRs that CLAUDE.md requires.
docs/Trace-*.json
# Playwright-Electron harness screenshot output (regenerated each run).
scripts/.morph-shots/
scripts/.send-shots/
scripts/.reveal-shots/
scripts/.wave-shots/

# Editor settings are personal — kept local, not shared via the repo.
.vscode/
.idea/

# Allow markdown in docs/ and adrs/ even though *.md is globally gitignored (CLAUDE.md rule)
*.md
!/README.md
!/LICENSE
!/CLAUDE.md
!/docs/**/*.md
!/adrs/**/*.md
.superpowers/
